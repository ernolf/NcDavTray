#__inc:modules/New-StatusIcon.ps1__
#__inc:modules/New-MountStatusIcon.ps1__

# Short human name of a mount, for menus and tooltips. The token is deliberately
# not part of it: it is the share's address, and the tray is a public surface.
function Get-MountTrayText([psobject]$Entry, [string]$Status, [int]$Rc = 0) {
	return (Get-TrayStatusText -Name (Get-MountDisplayName $Entry) -Drive ([string]$Entry.Drive) -Status $Status -Rc $Rc)
}
# Paints one mount's icon and tooltip. Update-Trays does it for the whole list
# once a poll is through; a connect attempt does it for itself before it starts,
# so the tray says what it is doing while it does it and not only afterwards.
function Set-MountTrayStatus([psobject]$Entry, [string]$Status, [int]$Rc = 0) {
	if (-not $Entry -or -not $script:Trays.ContainsKey($Entry.Id)) { return }
	$rec = $script:Trays[$Entry.Id]
	$rec.Status = $Status
	$rec.Rc = $Rc
	$old = $rec.Notify.Icon
	$rec.Notify.Icon = New-MountStatusIcon -Entry $Entry -Status $Status
	if ($old) { try { $old.Dispose() } catch {} }
	Set-TrayTipText $rec.Notify (Get-MountTrayText $Entry $Status $Rc)
}

#__inc:modules/Update-TrayTips.ps1__

#__inc:modules/Show-CustomBalloon.ps1__
#__inc:modules/Show-MountBalloon.ps1__
#__inc:modules/Show-ManagerBalloon.ps1__

# ---------- Tray actions ----------
#__inc:modules/Show-CredentialConflict.ps1__
#__inc:modules/Show-MountFailure.ps1__

# Connect and disconnect write Enabled, because a mount the user switched off has
# to stay off across the next poll and across a restart. Without that the timer
# would simply map it again a few seconds later.
function Connect-MountById([string]$Id) {
	$entry = Get-MountEntry $Id
	if (-not $entry) { return }
	if (-not $entry.Enabled) { $entry.Enabled = $true; Save-Config }
	# The password prompt is a modal dialog, and the poll keeps ticking behind it.
	$script:MountBusy = $true
	try {
		if (-not (Ensure-MountPassword -Entry $entry)) { return }
		[int]$rc = 0
		Set-MountTrayStatus $entry 'pending'
		$ok = Connect-MountEntry -Entry $entry -LastError ([ref]$rc)
		if (-not $ok) {
			# A password the server took but Windows could not use is worth asking for
			# again; anything else would keep re-trying the same rejected string.
			if ($rc -in @(5, 1244, 1326)) { (Get-MountRuntime $Id).Pass = $null }
			Show-MountFailure -Entry $entry -Code $rc
		}
		# The result goes along, or Update-Trays would ask the drive a second time and
		# get back a plain "failed" for what the error code just explained.
		$status = if ($ok) { 'online' } else { Get-MapFailureStatus $rc }
		Update-Trays @([pscustomobject]@{ Id = $entry.Id; Connected = $ok; Status = $status; LastError = $rc; Attempted = $true })
	} finally { $script:MountBusy = $false }
}
function Disconnect-MountById([string]$Id) {
	$entry = Get-MountEntry $Id
	if (-not $entry) { return }
	if ($entry.Enabled) { $entry.Enabled = $false; Save-Config }
	$spec = New-MountSpecFromEntry $entry
	# Telling the shell a drive has gone pumps the message loop, so a poll tick can
	# start here and map the letter again before this one has finished taking it
	# down. The entry is already disabled by then, but its claims are not released.
	$script:MountBusy = $true
	try {
		try { Unmap-DriveIfOurs -Spec $spec -Force -RemoveProfile } catch {}
		try { Remove-MapMutex -Spec $spec } catch {}
		try { Remove-DriveGuard -Drive $spec.Drive } catch {}
	} finally { $script:MountBusy = $false }
	Update-Trays
}
function Open-MountInExplorer([string]$Id) {
	$entry = Get-MountEntry $Id
	if (-not $entry) { return }
	if (-not (Test-DriveAccessible (New-MountSpecFromEntry $entry))) { return }
	try { Start-Process -FilePath 'explorer.exe' -ArgumentList $entry.Drive } catch {}
}
# The letters the configuration has already spoken for: two mounts on one letter
# is a fight neither of them wins.
function Get-ReservedDrives([string]$ExceptId = '') {
	$used = @()
	foreach ($e in @($State.Mounts)) { if ($e -and $e.Id -ne $ExceptId) { $used += [string]$e.Drive } }
	return $used
}
# Windows keeps one set of credentials per server identity and offers exactly two
# of them per host. With both already connected -- typically the account mapping
# and one other share -- a mount that needs a place of its own cannot come up,
# whatever it is called and whichever letter it gets. Saying so now beats an error
# 1219 afterwards, and it is still worth adding: the entry stays and connects once
# a place frees up. $true means carry on.
# A mount that presents the same login as a connection already up needs no place of
# its own -- it joins that one. A duplicate is exactly that case, and warning about
# it would be warning about nothing.
function Confirm-ServerIdentity([psobject]$Entry) {
	$idents = Get-UsedServerIdentities -Server $Entry.Server
	if (-not ($idents.Plain -and $idents.ExplicitPort)) { return $true }
	$others = @(@($State.Mounts) | Where-Object { $_ })
	if (Test-SharedServerIdentity -Entry $Entry -Others $others -HeldBy $idents.Drives) { return $true }
	return ((Show-CustomMsgBoxT 'message.confirm_server_identities_exhausted' @{ server = $Entry.Server } 'YesNo' 'Warning') -eq [System.Windows.Forms.DialogResult]::Yes)
}
function Add-ShareFromLink {
	$used = @(Get-ReservedDrives)
	$free = @(Get-FreeDriveLetters -Exclude $used)
	if ($free.Count -eq 0) { Show-WarnT 'message.no_free_drive_letter'; return }
	$entry = Show-AddShareDialog -Reserved $used
	if (-not $entry) { return }
	if (-not (Confirm-ServerIdentity $entry)) { return }
	$State.Mounts = @(@($State.Mounts) + $entry)
	Save-Config
	Connect-MountById $entry.Id
}
# A new account is put in front of the same page an existing one is edited on,
# opened on an entry that is not in the list yet -- see Set-AccountEditorContext,
# where the save is what puts it there. A window closed without saving leaves
# nothing behind.
function Add-Account {
	$used = @(Get-ReservedDrives)
	if (@(Get-FreeDriveLetters -Exclude $used).Count -eq 0) { Show-WarnT 'message.no_free_drive_letter'; return }
	# The mount identity of an account is the plain host: \\server@ssl\..., which is
	# what 1.x mapped and what an account taken over from a 1.x installation keeps.
	# The second identity belongs to a share that has to sit next to one of these.
	$entry = New-MountEntry -Kind 'account' -ExplicitPort $false
	[void](Show-AccountSettingsDialog -Entry $entry)
}
function Connect-AllMounts {
	# Held across the failure boxes as well: they are modal, and until the last of
	# them is away this run has not finished with the mounts it is reporting on.
	$script:MountBusy = $true
	try {
		$results = @()
		try { $results = Sync-Mounts -AskForPassword } catch {}
		Update-Trays $results
		# Connecting on request has to say what came of it, the same as connecting a
		# single mount does. The poll tick stays silent: it runs unasked, and a modal
		# box out of a timer is not an answer to anything.
		foreach ($r in @($results)) {
			if (-not $r -or $r.Connected -or -not $r.Attempted) { continue }
			$entry = Get-MountEntry $r.Id
			if ($entry) { Show-MountFailure -Entry $entry -Code $r.LastError }
		}
	} finally { $script:MountBusy = $false }
}
# The edited entry replaces the old one under the same Id, so the tray icon and
# the password already given stay with the mount. Where the edit changed what is
# mapped and not only how it is called, the old mapping has to go first: once the
# entry is replaced, nothing knows the letter and the path it used to hold.
function Update-ShareById([string]$Id) {
	$entry = Get-MountEntry $Id
	if (-not $entry) { return }
	# An account is edited on the account settings page, which saves and remaps
	# through the editor context, so there is nothing left to do here.
	if ($entry.Kind -eq 'account') { [void](Show-AccountSettingsDialog -Entry $entry); return }
	$edited = Show-EditMountDialog -Entry $entry -Reserved @(Get-ReservedDrives -ExceptId $Id)
	if (-not $edited) { return }
	$oldSpec = New-MountSpecFromEntry $entry
	# The name goes into the mount key nowhere, but Explorer reads it when the drive
	# is connected: a renamed mount keeps showing the old name until it is mapped
	# again. So a changed name remaps as well.
	if (((Get-MountKey $oldSpec) -ne (Get-MountKey (New-MountSpecFromEntry $edited))) -or ($entry.Label -ne $edited.Label)) {
		try { Unmap-DriveIfOurs -Spec $oldSpec -Force -RemoveProfile } catch {}
		try { Refresh-ExplorerDriveRemoval $oldSpec.Drive } catch {}
		try { Remove-MapMutex -Spec $oldSpec } catch {}
		try { Remove-DriveGuard -Drive $oldSpec.Drive } catch {}
	}
	$list = @()
	foreach ($e in @($State.Mounts)) { if ($e) { if ($e.Id -eq $Id) { $list += $edited } else { $list += $e } } }
	$State.Mounts = $list
	Save-Config
	if ($edited.Enabled) { Connect-MountById $Id } else { Update-Trays }
}
function Remove-ShareById([string]$Id) {
	$entry = Get-MountEntry $Id
	if (-not $entry) { return }
	if ((Show-CustomMsgBoxT 'message.confirm_remove_share' @{ share = (Get-MountDisplayName $entry) } 'YesNo' 'Question') -ne [System.Windows.Forms.DialogResult]::Yes) { return }
	$spec = New-MountSpecFromEntry $entry
	try { Unmap-DriveIfOurs -Spec $spec -Force -RemoveProfile } catch {}
	try { Refresh-ExplorerDriveRemoval $spec.Drive } catch {}
	try { Remove-MapMutex -Spec $spec } catch {}
	try { Remove-DriveGuard -Drive $spec.Drive } catch {}
	Remove-MountTray $Id
	$list = @()
	foreach ($e in @($State.Mounts)) { if ($e -and $e.Id -ne $Id) { $list += $e } }
	$State.Mounts = $list
	if ($script:Runtime.ContainsKey($Id)) { [void]$script:Runtime.Remove($Id) }
	Save-Config
	# A stored password outlives the mount it was given for, so the last mount that
	# used it has to say goodbye. For a share that is the only way it ever goes.
	Remove-UnusedAccountSecret -Server $entry.Server -User (Get-MountSecretName $entry)
	Update-Trays
}
# Removing a mount disposes its tray icon, and with it the menu the click came out
# of. Letting the message loop turn once first lets the dropdown close on its own
# before the ground is pulled out from under it.
function Request-ShareRemoval([string]$Id) {
	$script:PendingRemoveId = $Id
	$t = New-Object System.Windows.Forms.Timer
	$t.Interval = 1
	$t.Add_Tick({ $this.Stop(); $this.Dispose(); Remove-ShareById $script:PendingRemoveId })
	$t.Start()
}

# A clone is a mount in its own right from the first moment: its own Id and its
# own drive letter, everything else the same as the original, including the name.
# Nothing is copied that would then live a separate life -- the password is not
# the mount's but the server/user pair's, so both mounts are served by the one
# value and a password changed on either is changed for both.
function Copy-ShareById([string]$Id) {
	$src = Get-MountEntry $Id
	if (-not $src) { return }
	$used = @(Get-ReservedDrives)
	if (@(Get-FreeDriveLetters -Exclude $used).Count -eq 0) { Show-WarnT 'message.no_free_drive_letter'; return }
	$copy = New-MountEntry -Server $src.Server -Kind $src.Kind -User $src.User -Token $src.Token -SubPath $src.SubPath -Drive '' -Label ([string]$src.Label) -ExplicitPort:([bool]$src.ExplicitPort) -Enabled:$true
	$edited = Show-EditMountDialog -Entry $copy -Reserved $used
	if (-not $edited) { return }
	if (-not (Confirm-ServerIdentity $edited)) { return }
	$State.Mounts = @(@($State.Mounts) + $edited)
	Save-Config
	Connect-MountById $edited.Id
}
#__inc:modules/Update-ListViewColumns.ps1__
#__inc:modules/Update-ShareListView.ps1__
#__inc:modules/Show-AddMenu.ps1__

# ================================================================
#	Settings dialog
# ================================================================
# The window frame only: what goes on the tab pages lives in the renderers.
function Show-SettingsDialog {
	# Guard: prevent multiple settings windows
	if ($script:IsSettingsOpen -and $script:SettingsForm -and (-not $script:SettingsForm.IsDisposed)) {
		try { $script:SettingsForm.WindowState = [System.Windows.Forms.FormWindowState]::Normal; $script:SettingsForm.Activate(); $script:SettingsForm.BringToFront() } catch {}
		return [System.Windows.Forms.DialogResult]::Cancel
	}
	# global tooltip (single instance, reused everywhere)
	$script:Tip = New-Object System.Windows.Forms.ToolTip
	$script:Tip.InitialDelay = 300 # delay before first show (ms)
	$script:Tip.ReshowDelay = 100 # delay for subsequent shows (ms)
	$script:Tip.ShowAlways = $true # also show for disabled controls
	# Mark as open early
	$script:IsSettingsOpen = $true
	# Create host form (chrome only)
	$f = $script:HostForm = New-Object System.Windows.Forms.Form; Apply-BrandIconToForm $f; Hook-FormDpi $f
	$f.Text = (T 'title.settings_dialog' @{ app = $AppName }); $f.ShowInTaskbar = $false; $f.TopMost = $true; $f.FormBorderStyle = [System.Windows.Forms.FormBorderStyle]::FixedDialog
	$f.MaximizeBox = $false; $f.MinimizeBox = $false
	$f.Width = 680
	$f.Height = 520
	$f.StartPosition = [System.Windows.Forms.FormStartPosition]::CenterScreen
	# --- TabControl host (chrome stays on $f) ---
	$script:Tabs = New-Object System.Windows.Forms.TabControl
	$script:Tabs.Left = 8; $script:Tabs.Top = 8; $script:Tabs.Width = $f.ClientSize.Width - 16; $script:Tabs.Height = $f.ClientSize.Height - 16; $script:Tabs.Anchor = 'Top, Left, Right, Bottom'
	$script:Tabs.Appearance = 'Buttons' # 'Normal' | 'Buttons' | 'FlatButtons'
	$script:Tabs.HotTrack = $true; $script:Tabs.TabStop = $false # keep focus inside the active TabPage
	# Tab: Shares
	$tabShares = $script:TabShares = New-Object System.Windows.Forms.TabPage; $tabShares.Text = (T 'tab.shares'); $tabShares.Padding = '6, 6, 6, 6'
	# Tab: WebClient Tuning
	$tabTuning = $script:TabTuning = New-Object System.Windows.Forms.TabPage; $tabTuning.Text = (T 'tab.webclient_tuning'); $tabTuning.Padding = '6, 6, 6, 6'
	# Tab: WebDAV cache cleanup (on-demand admin cleaner)
	$tabCache = $script:TabCache = New-Object System.Windows.Forms.TabPage; $tabCache.Text = (T 'tab.webdav_cache'); $tabCache.Padding = '6, 6, 6, 6'
	[void]$script:Tabs.TabPages.Add($tabShares); [void]$script:Tabs.TabPages.Add($tabTuning); [void]$script:Tabs.TabPages.Add($tabCache)
	$f.Controls.Add($script:Tabs)
	# Render content into each tab page (container ! = HostForm)
	Render-SharesTab -HostTab $tabShares; Render-WebClientTuningTab -HostTab $tabTuning; Render-WebDavCacheTab -HostTab $tabCache
	# A window that cannot be resized has to be built around what is in it, and how
	# much room the tab strip and the page insets leave is only known once it is
	# there. Load is early enough: the sizes are settled and nothing has been drawn.
	# A button that does not fit is a button the user cannot reach.
	$f.add_Load({
			$panel = $script:ShareButtonPanel
			if (-not $panel -or $panel.IsDisposed) { return }
			$short = $panel.PreferredSize.Height - $panel.Height
			if ($short -gt 0) { $this.Height += $short }
		})
	# Registered after the handler above, so what gets centred is the window the
	# user ends up with and not the one it was built as.
	Hook-FormScreen $f
	# The list reads what the poll has worked out, but a window opened before the
	# first poll is through has nothing to read and asks the servers itself -- a
	# status request each, a read per drive -- and none of that may happen before
	# there is something to look at. Shown is after the first paint, Refresh makes
	# sure that paint has actually landed, and the wait cursor says the window is
	# working. A window that looks like it is doing nothing gets clicked again.
	$f.add_Shown({
			$this.UseWaitCursor = $true
			$this.Refresh()
			try { Update-ShareListView $script:ShareListView } finally { $this.UseWaitCursor = $false }
		})
	# Track the window and show
	$script:SettingsForm = $f
	$dlg = $f.ShowDialog()
	# Reset open flag on close
	$script:IsSettingsOpen = $false
	$script:SettingsForm = $null; $script:HostForm = $null
	try { $f.Dispose() } catch {}
	# The row icons hang on an image list the list view was handed, not one it owns,
	# and a form disposes what is in it -- this would be left holding its handles.
	try { if ($script:ShareStatusIcons) { $script:ShareStatusIcons.Dispose(); $script:ShareStatusIcons = $null } } catch {}
	return $dlg
}
