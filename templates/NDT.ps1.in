# Looks up a configured mount by its Id, or $null if it is gone.
function Get-MountEntry([string]$Id) {
	foreach ($e in $State.Mounts) { if ($e.Id -eq $Id) { return $e } }
	return $null
}

# ================================================================
# ---------- Config I/O ----------
function Save-Config {
	if ($IsInstalled) {
		$base = Get-RegBase
		if (-not (Test-Path -LiteralPath $base)) { New-Item -Path $base -Force | Out-Null }
		New-ItemProperty -LiteralPath $base -Name 'IntervalS' -Value ([int]$State.IntervalS) -PropertyType DWord -Force | Out-Null
		New-ItemProperty -LiteralPath $base -Name 'LangPref' -Value ([string]$State.LangPref) -PropertyType String -Force | Out-Null
		New-ItemProperty -LiteralPath $base -Name 'TrayIcons' -Value ([int][bool]$State.TrayIcons) -PropertyType DWord -Force | Out-Null
		New-ItemProperty -LiteralPath $base -Name 'UpdateCheck' -Value ([int][bool]$State.UpdateCheck) -PropertyType DWord -Force | Out-Null
		Write-MountEntriesToRegistry -Entries @($State.Mounts)
		return
	}
	# Depth 4: at the default depth the entries inside Mounts would be written as
	# type names instead of objects.
	$State | ConvertTo-Json -Depth 4 | Set-Content -Path $PortJson -Encoding UTF8
}
function Load-Config {
	if ($IsInstalled) {
		# Before anything is read, so the account of an older copy is part of the list
		# this reads and not something found later.
		try { Import-LegacyFlatAccount } catch {}
		$base = Get-RegBase
		if (Test-Path -LiteralPath $base) {
			try {
				$p = Get-ItemProperty -LiteralPath $base -ErrorAction Stop
				$have = $p.PSObject.Properties.Name
				if ($have -contains 'IntervalS') { try { $State.IntervalS = [int]$p.IntervalS } catch {} }
				if ($have -contains 'LangPref') { $State.LangPref = [string]$p.LangPref }
				if ($have -contains 'TrayIcons') { try { $State.TrayIcons = [bool][int]$p.TrayIcons } catch {} }
				if ($have -contains 'UpdateCheck') { try { $State.UpdateCheck = [bool][int]$p.UpdateCheck } catch {} }
			} catch {}
		}
		$State.Mounts = @(Read-MountEntriesFromRegistry)
		return
	}
	# No configuration of our own yet: whatever a copy up to 1.2.2 left in this
	# folder is taken over, and Save-Config puts it into the file this version
	# reads. With nothing to take over it writes the defaults, as a first start.
	if (-not (Test-Path $PortJson)) {
		try { [void](Import-LegacyPortableConfig -Path $LegacyPortJson) } catch {}
		Save-Config
		return
	}
	$raw = $null
	try { $raw = Get-Content -Raw -Path $PortJson -Encoding UTF8 | ConvertFrom-Json } catch { $raw = $null }
	# An unreadable file keeps its content: overwriting it with defaults would
	# throw away every configured mount because of one stray character.
	if ($null -eq $raw) { Show-WarnT 'message.config_unreadable' @{ path = $PortJson }; return }
	$have = $raw.PSObject.Properties.Name
	if ($have -contains 'IntervalS') { try { $State.IntervalS = [int]$raw.IntervalS } catch {} }
	if ($have -contains 'LangPref') { $State.LangPref = [string]$raw.LangPref }
	if ($have -contains 'TrayIcons') { try { $State.TrayIcons = [bool]$raw.TrayIcons } catch {} }
	if ($have -contains 'UpdateCheck') { try { $State.UpdateCheck = [bool]$raw.UpdateCheck } catch {} }
	$entries = @()
	if ($have -contains 'Mounts') { foreach ($m in @($raw.Mounts)) { if ($m) { $entries += (ConvertTo-MountEntry $m) } } }
	$State.Mounts = $entries
}

