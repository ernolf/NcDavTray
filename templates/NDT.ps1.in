# ---------- Tray icons ----------
function New-MountTray([psobject]$Entry) {
	$ni = New-Object System.Windows.Forms.NotifyIcon
	$menu = New-Object System.Windows.Forms.ContextMenuStrip
	$menu.Tag = $Entry.Id
	$miConn = $menu.Items.Add((T 'menu.connect')); $miConn.Tag = $Entry.Id; $miConn.Add_Click({ Connect-MountById $this.Tag })
	$miDisc = $menu.Items.Add((T 'menu.disconnect')); $miDisc.Tag = $Entry.Id; $miDisc.Add_Click({ Disconnect-MountById $this.Tag })
	$miOpen = $menu.Items.Add((T 'menu.open_explorer')); $miOpen.Tag = $Entry.Id; $miOpen.Add_Click({ Open-MountInExplorer $this.Tag })
	# The settings of the mount this icon stands for, reachable from the icon itself
	# the way NcDavTray offers them for its drive. For an account that is where its
	# password is set, and a clone of an account is an account: it is listed nowhere
	# else, so leaving it to the settings window would leave it out of reach.
	$miSett = $menu.Items.Add((T 'menu.settings')); $miSett.Tag = $Entry.Id; $miSett.Add_Click({ Update-ShareById ([string]$this.Tag) })
	[void]$menu.Items.Add((New-Object System.Windows.Forms.ToolStripSeparator))
	# Not Exit: this menu belongs to one mount, and what it may end is that mount.
	# Ending the program is a decision about the whole family and lives on the
	# application icon.
	$miRemove = $menu.Items.Add((T 'button.remove')); $miRemove.Tag = $Entry.Id; $miRemove.Add_Click({ Request-ShareRemoval ([string]$this.Tag) })
	# What is offerable comes from the last poll rather than from asking the drive
	# here: reading a WebDAV drive takes as long as the server needs, and this runs
	# on the UI thread while the menu is coming up. A menu that keeps the user
	# waiting invites a second right click, and that one opens a second dropdown
	# while the first is left standing with nothing to close it.
	$menu.Add_Opening({
			try {
				$rec = $script:Trays[$this.Tag]
				$live = [bool]($rec -and $rec.Status -eq 'online')
				# A mount that is not up has nothing to disconnect, but it can still be
				# switched off -- and that is the only way to stop the poll retrying one
				# that never comes up. Off, there is nothing left for the item to do.
				$entry = Get-MountEntry ([string]$this.Tag)
				$enabled = [bool]($entry -and $entry.Enabled)
				$this.Items[0].Enabled = -not $live
				$this.Items[1].Enabled = $live -or $enabled
				$this.Items[2].Enabled = $live
				# Relabel on open, so a language change reaches these menus too
				$this.Items[0].Text = (T 'menu.connect')
				$this.Items[1].Text = if ($enabled -and -not $live) { T 'menu.disable' } else { T 'menu.disconnect' }
				$this.Items[2].Text = (T 'menu.open_explorer')
				$this.Items[3].Text = (T 'menu.settings')
				$this.Items[5].Text = (T 'button.remove')
			} catch {}
		})
	$ni.ContextMenuStrip = $menu
	$ni.Add_MouseClick({
			param($s, $e)
			if ($e.Button -eq [System.Windows.Forms.MouseButtons]::Left) { Show-MountBalloon ([string]$s.Tag) }
		})
	$ni.Add_MouseDoubleClick({
			# The first click of a double click has already put the balloon up, and it
			# has nothing left to say next to the window Explorer is about to open.
			try { if ($script:BalloonForm -and -not $script:BalloonForm.IsDisposed) { $script:BalloonForm.Close() } } catch {}
			Open-MountInExplorer $this.Tag
		})
	$ni.Tag = $Entry.Id
	Register-TrayHoverTip $ni
	return [pscustomobject]@{ Id = $Entry.Id; Notify = $ni; Menu = $menu; Status = 'failed'; Rc = 0 }
}
function Remove-MountTray([string]$Id) {
	if (-not $script:Trays.ContainsKey($Id)) { return }
	$rec = $script:Trays[$Id]
	try { $rec.Notify.Visible = $false } catch {}
	try { if ($rec.Notify.Icon) { $rec.Notify.Icon.Dispose() } } catch {}
	try { Unregister-TrayHoverTip $rec.Notify } catch {}
	try { $rec.Notify.Dispose() } catch {}
	try { $rec.Menu.Dispose() } catch {}
	$script:Trays.Remove($Id)
}
# Brings the tray in line with the configuration: one icon per configured mount,
# none for anything else. Results is what Sync-Mounts returned; where an entry is
# missing from it the drive is asked directly, so the function also works when
# called after a single action.
function Update-Trays([psobject[]]$Results) {
	$byId = @{}
	foreach ($r in @($Results)) { if ($r) { $byId[$r.Id] = $r } }
	$wanted = @{}
	foreach ($entry in @($State.Mounts)) {
		# A disabled mount keeps its icon and shows red. NcDavTray does the same for
		# its own drive after Disconnect: the mount is configured, it is only down,
		# and an icon that vanishes reads as a mount the program has lost.
		if (-not $entry) { continue }
		$wanted[$entry.Id] = $true
		if (-not $script:Trays.ContainsKey($entry.Id)) { $script:Trays[$entry.Id] = New-MountTray $entry }
		$rec = $script:Trays[$entry.Id]
		$status = if ($byId.ContainsKey($entry.Id)) { [string]$byId[$entry.Id].Status } else { Get-MountStatus -Spec (New-MountSpecFromEntry $entry) -Enabled ([bool]$entry.Enabled) }
		$lastRc = if ($byId.ContainsKey($entry.Id)) { [int]$byId[$entry.Id].LastError } else { 0 }
		# The menus and balloons read this instead of asking the drive themselves
		Set-MountTrayStatus $entry $status $lastRc
		$rec.Notify.Visible = [bool]$State.TrayIcons
	}
	# Snapshot the keys: Remove-MountTray edits the table
	foreach ($id in @($script:Trays.Keys)) { if (-not $wanted.ContainsKey($id)) { Remove-MountTray $id } }
}
# The switch in the settings window, applied to the icons that already exist. The
# icons themselves are kept either way: they carry the status the settings window
# and the application balloon read, and polling them again for a checkbox would
# cost a round trip to every server. The application icon is not one of these --
# it is the one icon that has to stay, see New-ManagerTray.
function Update-TrayIconVisibility {
	foreach ($id in @($script:Trays.Keys)) { try { $script:Trays[$id].Notify.Visible = [bool]$State.TrayIcons } catch {} }
}
# The application icon is always there, even with nothing configured -- otherwise
# an empty tray would leave no way to reach the program at all.
function New-ManagerTray {
	$ni = New-Object System.Windows.Forms.NotifyIcon
	Ensure-AppBrandIcons
	if ($script:AppIcon) { $ni.Icon = $script:AppIcon }
	$menu = New-Object System.Windows.Forms.ContextMenuStrip
	# Which of the two copies this is, said where every menu of the program starts.
	# It decides what the program may do with itself -- install, export, uninstall --
	# and the colours are the ones the settings window uses for the same two words.
	$miMode = New-Object System.Windows.Forms.ToolStripLabel
	$miMode.Font = New-Object System.Drawing.Font($menu.Font, $UiFontStyleBold)
	$miMode.ForeColor = if ($PortableMode) { [System.Drawing.Color]::ForestGreen } else { [System.Drawing.Color]::SteelBlue }
	[void]$menu.Items.Add($miMode)
	[void]$menu.Items.Add((New-Object System.Windows.Forms.ToolStripSeparator))
	$miAdd = $menu.Items.Add((T 'menu.add_share_link')); $miAdd.Add_Click({ Add-ShareFromLink })
	$miAccount = $menu.Items.Add((T 'menu.add_account')); $miAccount.Add_Click({ Add-Account })
	# The settings live on the application icon alone: a mount's own menu can remove
	# that very mount, and with it the menu the click came out of.
	$miSettings = $menu.Items.Add((T 'menu.settings')); $miSettings.Add_Click({ [void](Show-SettingsDialog) })
	$miAll = $menu.Items.Add((T 'menu.connect_all')); $miAll.Add_Click({ Connect-AllMounts })
	[void]$menu.Items.Add((New-Object System.Windows.Forms.ToolStripSeparator))
	# About belongs to the installation, not to a single drive, so it is here and not
	# in a mount's menu.
	$miAbout = $menu.Items.Add((T 'menu.about')); $miAbout.Add_Click({ Show-AboutDialog })
	[void]$menu.Items.Add((New-Object System.Windows.Forms.ToolStripSeparator))
	$miExit = $menu.Items.Add((T 'menu.exit')); $miExit.Add_Click({ Quit-App })
	# Connecting needs something to work on: with nothing configured the entry would
	# do nothing. The settings stay reachable either way -- that is where the first
	# share is added. The labels are put on here rather than only at build time, so
	# a language picked in the settings shows the next time the menu opens.
	$menu.Add_Opening({
			$has = @(@($State.Mounts) | Where-Object { $_ }).Count -gt 0
			$this.Items[5].Enabled = $has
			$this.Items[0].Text = if ($PortableMode) { (T 'mode.portable') } else { (T 'mode.installed') }
			$this.Items[2].Text = (T 'menu.add_share_link')
			$this.Items[3].Text = (T 'menu.add_account')
			$this.Items[4].Text = (T 'menu.settings')
			$this.Items[5].Text = (T 'menu.connect_all')
			$this.Items[7].Text = (T 'menu.about')
			$this.Items[9].Text = (T 'menu.exit')
		})
	$ni.ContextMenuStrip = $menu
	$ni.Add_MouseClick({
			param($s, $e)
			if ($e.Button -eq [System.Windows.Forms.MouseButtons]::Left) { Show-ManagerBalloon }
		})
	Register-TrayHoverTip $ni
	Set-TrayTipText $ni (T 'tray.manager' @{ app = $AppName })
	$ni.Visible = $true
	return [pscustomobject]@{ Notify = $ni; Menu = $menu }
}
# An empty $Lang is "Auto". Nothing is rebuilt -- every menu puts its labels on
# when it opens, and the tray tooltips are rewritten by the next poll.
function Set-UiLanguage([string]$Lang) {
	$State.LangPref = $Lang
	Save-Config
	Initialize-I18n $State.LangPref
	Update-TrayTips
}
# Exit on the application icon takes every drive with it: the icon of a single
# mount has no exit of its own.
function Quit-App {
	$script:Quitting = $true
	try { if ($script:timer) { $script:timer.Stop() } } catch {}
	Unmap-AllMounts
	foreach ($id in @($script:Trays.Keys)) { Remove-MountTray $id }
	[System.Windows.Forms.Application]::Exit()
}

# ================================================================
#	Watchdog (separate process guard)
# ================================================================
#__inc:modules/Run-Watchdog.ps1__

# ================================================================
#	Installed instance control (stop / start)
# ================================================================
#__inc:modules/Get-RunningInstalledMain.ps1__
#__inc:modules/Stop-InstalledInstance.ps1__
#__inc:modules/Start-InstalledInstance.ps1__

# ================================================================
#	Startup
# ================================================================
# The language preference is part of the configuration, but the single-instance
# check and Load-Config itself can already have something to say. So i18n comes up
# first on the system language and is redone once the preference is known.
Initialize-I18n
# The cache agent is a worker, not a second copy of the program: it must not take
# the single-instance lock and it never puts a tray icon up.
if ($Action -eq 'CacheAgent') { CacheAgent -OwnerPid $OwnerPid -IntervalSeconds $IntervalSeconds; return }
# The same goes for the watchdog, and it has to come before the lock as well: it
# is the copy that has to still be there once this one is not.
if ($Watchdog) { Run-Watchdog -OnOwnerGone { Unmap-AllMounts }; return }
# What Installer.cmd asks for. Both run without a tray and without the lock: this
# copy is here to write a folder, not to mount anything, and the instance it is
# writing over is the one that has to go instead.
if ($Action -eq 'Install') {
	$script:FromInstaller = $true
	# The script cannot be replaced under a copy that is running it, and the drives
	# that copy holds would still be there afterwards with nothing behind them.
	if (-not (Stop-InstalledInstance -TimeoutSec 12 -ForceOnTimeout)) { Write-Warning 'Some installed instance(s) did not exit in time; proceeding with installation anyway.' }
	Install-App -FromInstaller
	[void](Start-InstalledInstance)
	return
}
if ($Action -eq 'ExportPortable') {
	$script:FromInstaller = $true
	Export-AppToPortable -Force
	return
}
Ensure-SingleInstanceForConfig
# Up to 1.2.2 the drive icon was cached beside the script. Nothing reads that
# file any more, and it is taken away wherever it is still lying about.
try { Remove-LegacyFavIcon } catch {}
Load-Config
Initialize-I18n
# The passphrase question of a portable copy, before anything is mounted: an account
# whose password is still locked away would come up as a red drive letter, and being
# asked about it afterwards explains none of what was already seen going wrong.
if (-not (Unlock-PortableSecretStore)) { exit }
# The elevated cache agent outlives the window that started it and asks the
# instance list whether anything is still there to serve.
try { Register-Instance -Role 'Ui' -Tag 'manager' } catch {}

$script:TrayManager = New-ManagerTray
# Nothing appears in the notification area until the message loop runs, so the
# first connect has to wait for it. Every mount asks its server before it is put
# up, and on a slow or unreachable one that is seconds each -- done here, the
# tray would stay empty for all of them with nothing to say why. The one tick
# fires as soon as the loop is idle, which is right after the icon is out.
# Asking for every share's password at startup is the price of never storing one.
$script:startupTimer = New-Object System.Windows.Forms.Timer
$script:startupTimer.Interval = 1
$script:startupTimer.Add_Tick({ $this.Stop(); $this.Dispose(); Connect-AllMounts })
$script:startupTimer.Start()

# Only when it was asked for, and behind the mounts rather than in front of them:
# the answer is nothing anyone is waiting for, and the request holds this thread
# for as long as the project page needs. A balloon, because it interrupts nothing
# -- and only when there is something to say. Up to date and out of reach are both
# answers nobody asked to be told about.
if ($State.UpdateCheck) {
	$script:updateTimer = New-Object System.Windows.Forms.Timer
	$script:updateTimer.Interval = 3000
	$script:updateTimer.Add_Tick({
			$this.Stop(); $this.Dispose()
			$info = $null
			try { $info = Get-UpdateInfo } catch {}
			if ($info -and $info.Ok -and $info.Newer) {
				$shown = if ($info.Version) { $info.Version.ToString() } else { $info.Tag }
				try { Show-CustomBalloon -Title $AppName -Text (T 'label.update_available' @{ version = $shown }) -TimeoutMs 6600 } catch {}
			}
		})
	$script:updateTimer.Start()
}

# The poll keeps the mounts up but never asks for anything: a dialog out of a
# timer tick would interrupt whatever the user is doing at that moment.
$script:timer = New-Object System.Windows.Forms.Timer
$script:timer.Interval = ([Math]::Max(5, [int]$State.IntervalS) * 1000)
$script:timer.Add_Tick({
		# Skipped, not queued: the tick is a poll, and the next one is fifteen
		# seconds away. What is running has the drives in hand anyway.
		if ($script:Quitting -or $script:MountBusy) { return }
		$script:MountBusy = $true
		try {
			$results = @()
			try { $results = Sync-Mounts } catch {}
			try { Update-Trays $results } catch {}
			# The settings list shows the same states the icons do, and with the icons
			# switched off it is the only place that shows them. It reads what the poll
			# has just written, so this costs the redraw and nothing else.
			try { if ($script:ShareListView -and -not $script:ShareListView.IsDisposed) { Update-ShareListView $script:ShareListView } } catch {}
		} finally { $script:MountBusy = $false }
	})
$script:timer.Start()

# The guard needs a way to tell whether this process is still there, and a named
# mutex vanishes with it however it ends -- killed included, which a PID does not
# survive being reused. One guard per process, so a restart never doubles them.
$script:MainMutexName = "Local\{0}Main-{1}" -f $AppName, $PID
try { $script:mainMutex = New-Object System.Threading.Mutex($true, $script:MainMutexName) } catch { $script:mainMutex = $null }
$wdKey = "Local\{0}Watchdog-{1}" -f $AppName, $PID
try {
	[void][System.Threading.Mutex]::OpenExisting($wdKey)
	# already running for this PID
} catch {
	$exe = "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe"
	$args = "-WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -STA -File `"$PSCommandPath`" -Watchdog -MainMutexName `"$script:MainMutexName`" -OwnerPid $PID"
	Start-Process -FilePath $exe -ArgumentList $args -WorkingDirectory (Split-Path -Parent $PSCommandPath) -WindowStyle Hidden | Out-Null
}

$exitHandler = [System.EventHandler]{
	try { [System.Windows.Forms.Application]::remove_ApplicationExit($exitHandler) } catch {}
	try { [AppDomain]::CurrentDomain.remove_ProcessExit($exitHandler) } catch {}
	try { if ($script:timer) { $script:timer.Stop(); $script:timer.Dispose() } } catch {}
	# Unmap before the mutex goes: from that moment the watchdog would start doing
	# the same work, on the same drives, from another process.
	try { Unmap-AllMounts } catch {}
	try { if ($script:mainMutex) { $script:mainMutex.ReleaseMutex() | Out-Null; $script:mainMutex.Dispose() } } catch {}
	foreach ($id in @($script:Trays.Keys)) { try { Remove-MountTray $id } catch {} }
	try { if ($script:TrayManager) { $script:TrayManager.Notify.Visible = $false; $script:TrayManager.Notify.Dispose(); $script:TrayManager.Menu.Dispose() } } catch {}
	try { Remove-MapMutex } catch {}
	try { Remove-DriveGuard } catch {}
	try { Release-MutexSafe $script:cfgMutex } catch {}
	try { if ($script:ServerFaviconBmp) { $script:ServerFaviconBmp.Dispose() } } catch {}
	try { if ($script:AppIcon) { $script:AppIcon.Dispose() } } catch {}
	# instance list last: leaving it can release the cache watcher, and the
	# drives have to be gone before it starts deleting under them
	try { Unregister-Instance -Role 'Ui' } catch {}
}
[System.Windows.Forms.Application]::add_ApplicationExit($exitHandler)
[AppDomain]::CurrentDomain.add_ProcessExit($exitHandler)

[System.Windows.Forms.Application]::Run()