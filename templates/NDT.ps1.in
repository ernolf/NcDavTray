# Brings every configured mount to the state its entry asks for and returns a
# result per entry, so the tray layer can render each mount without repeating the
# work. A single entry never aborts the run: unrelated mounts have no reason to
# suffer from one unreachable server.
function Sync-Mounts {
	[CmdletBinding()] param( [switch]$AskForPassword )
	$results = @()
	foreach ($entry in @($State.Mounts)) {
		if (-not $entry) { continue }
		$ok = $false
		$attempted = $false
		[int]$rc = 0
		$spec = $null
		try { $spec = New-MountSpecFromEntry $entry } catch {}
		# Asking the server before the drive is not only tidier, it is cheaper: a
		# host that does not answer explains every mount on it, and a map attempt
		# against it costs a full timeout per mount instead of one status request.
		# The drive is asked, not told: a mount that is up has to be able to say so,
		# or every poll ends up rebuilding what is already there.
		$status = if ($spec) { Get-MountStatus -Spec $spec -Enabled ([bool]$entry.Enabled) } else { 'invalid_drive' }
		if (-not $entry.Enabled) {
			# Disabled means "not mapped by us", not "not ours": no -Force, so a
			# letter that meanwhile belongs to someone else is left alone. The claim
			# goes with it, so another instance may take the mount over.
			if ($spec) {
				try { Unmap-DriveIfOurs -Spec $spec } catch {}
				try { Remove-MapMutex -Spec $spec } catch {}; try { Remove-DriveGuard -Drive $spec.Drive } catch {}
			}
		} elseif ($status -in @('offline', 'maintenance')) {
			# Same answer NcDavTray gives: the drive goes with the server. A WebDAV
			# letter pointing at nothing hangs every Explorer window that touches it,
			# and the next poll maps it again once the server is back.
			try { Unmap-DriveIfOurs -Spec $spec -Force -RemoveProfile } catch {}
			# The password is still worth asking for where the user asked for the
			# connection: it is what lets a later poll bring the mount up by itself
			# once the server is back, and a poll tick may not put a box on screen.
			if ($AskForPassword) { try { [void](Ensure-MountPassword -Entry $entry) } catch {} }
		} elseif ($status -eq 'online') {
			# The letter is connected to this target and reads. There is nothing to
			# do to it, and doing it anyway would take a working mount down and put
			# it back up while the tray reported the round trip as a status change.
			# The claims are renewed because a mount left over from an earlier run is
			# found here, not mapped here, and would otherwise be held by nobody.
			$ok = $true
			try { [void](Ensure-DriveGuard -Drive $spec.Drive) } catch {}
			try { [void](Ensure-MapMutex $spec) } catch {}
			try { Ensure-BrandingTick $spec } catch {}
		} elseif ($status -ne 'invalid_drive') {
			# Only where the user asked for the connection: the modal prompt would
			# otherwise pop up out of a poll tick, once per mount, unprovoked. Where it
			# may not ask, an answer already given still counts and a missing one is the
			# end of it: Map-MountEntry stops at a password it does not have, so the
			# connect could only fail, and the mount would go pending on every tick for
			# it. A prompt that was cancelled is left where the user left it.
			$havePass = $null -ne (Get-MountRuntime $entry.Id).Pass
			if ($AskForPassword) { try { $havePass = [bool](Ensure-MountPassword -Entry $entry) } catch { $havePass = $false } }
			if ($havePass) {
				$attempted = $true
				Set-MountTrayStatus $entry 'pending'
				try { $ok = Connect-MountEntry -Entry $entry -LastError ([ref]$rc) } catch { $ok = $false }
			}
			# The server has already answered for this tick, so the drive is all that
			# is left to judge -- and the connect just did that.
			$status = Get-MountStatus -Spec $spec -Connected $ok -SkipServerCheck
			if ($attempted -and -not $ok) { $status = Get-MapFailureStatus $rc }
		}
		# Attempted says whether the mount got as far as the connect. Where it did
		# not, the reason is already known to the user -- a cancelled password
		# prompt, a share the server no longer has -- and needs no second word.
		$results += [pscustomobject]@{ Id = $entry.Id; Connected = $ok; Status = $status; LastError = $rc; Attempted = $attempted }
	}
	return $results
}

